---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProcess, formatDate, pad } from '../../lib/utils';

export async function getStaticPaths() {
  const items = await getProcess();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} image={d.cover} type="article">
  <article>
    <header class="wrap page-head">
      <div class="meta label">
        <a href="/process/">← Process</a>
        <span><span class="status">{d.status}</span> — <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
      </div>
      <h1 class="display">"{d.title}"</h1>
      <p class="lede">{d.summary}</p>
    </header>
    <div class="wrap">
      {d.cover && <img class="cover" src={d.cover} alt="" />}
      <div class="prose body"><Content /></div>
      {d.images.length > 0 && (
        <section class="board" aria-label="Process images">
          {d.images.map((g, i) => (
            <figure>
              <img src={g.image} alt={g.caption ?? `Process image ${i + 1}`} loading="lazy" />
              <figcaption class="label label--muted"><span>Fig. {pad(i + 1)}</span>{g.caption && <span>{g.caption}</span>}</figcaption>
            </figure>
          ))}
        </section>
      )}
    </div>
  </article>
</Base>

<style>
  .status { background: var(--yellow); padding: 0 8px; border: 1.5px solid var(--ink); }
  .cover { width: 100%; border: 1px solid var(--ink); margin-bottom: 56px; }
  .board { columns: 2 420px; column-gap: 32px; margin-top: 72px; }
  figure { break-inside: avoid; margin: 0 0 32px; }
  figure img { width: 100%; border: 1px solid var(--ink); }
  figcaption { display: flex; justify-content: space-between; gap: 16px; padding-top: 10px; }
</style>
